# Copy to .env and fill in for local development.
# Prisma supports the native PostgreSQL connection string format:
# https://pris.ly/d/connection-strings
#
# This matches the self-contained local instance set up per README.md ("Local Postgres
# instance") — a dedicated data dir on port 5433, isolated from any system Postgres install.
DATABASE_URL="postgresql://tcms:tcms_dev_pw@127.0.0.1:5433/tcms_dev?schema=public"

PORT=3001
JWT_SECRET="change-me-to-a-long-random-value"
JWT_EXPIRES_IN="8h"

# Used by `npm run seed` to bootstrap the first organization + admin account (login can't
# create either, since POST /users itself requires an already-logged-in admin).
SEED_ORG_NAME="Default Lab"
SEED_ORG_SLUG="default-lab"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"
