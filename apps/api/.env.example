# Copy to .env and fill in for local development.
# Prisma supports the native PostgreSQL connection string format:
# https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://tcms:tcms@localhost:5432/tcms_dev?schema=public"

PORT=3001
JWT_SECRET="change-me-to-a-long-random-value"
JWT_EXPIRES_IN="8h"

# Used by `npm run seed` to bootstrap the first admin account (login can't create it, since
# POST /users itself requires an admin).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"
